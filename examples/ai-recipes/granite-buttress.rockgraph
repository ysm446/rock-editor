{
  "format": "rock-editor.scene",
  "version": 1,
  "graph": {
    "nodes": [
      {"id": 1, "kind": "baseRock", "note": "節理で割られる前の岩体。最終形より大きめにして、外に見える面が全て節理の面になるまで侵食する", "baseRock": {"shape": "box", "size": [9, 12, 5]}},
      {"id": 2, "kind": "parallelPlanes", "note": "主な節理: 急傾斜（約 76°）、間隔を狭く。塔はこの面で縦長の柱に分かれる", "parallelPlanes": {"rotation": [0, 0, 76], "spacing": 0.95, "variation": 0.7, "seed": 2}},
      {"id": 3, "kind": "parallelPlanes", "note": "交わる節理: 緩く傾いた面、間隔を広く。柱を段に区切り、上のブロックはこの面で下に載る", "parallelPlanes": {"rotation": [0, 0, -22], "spacing": 2.2, "variation": 0.8, "seed": 5}},
      {"id": 4, "kind": "parallelPlanes", "note": "3 系統目: 奥行き方向のほぼ鉛直な面。連結すると上流の 2 系統にこの系統が足される", "parallelPlanes": {"rotation": [90, 15, 0], "spacing": 2.0, "variation": 0.6, "seed": 8}},
      {"id": 5, "kind": "voronoiFracture", "note": "Planes 入力: 全系統の面で岩体を節理のブロックに割る（Points は繋がない）"},
      {"id": 6, "kind": "pieceSelect", "note": "外周からの侵食（凍結破砕でブロックが抜け落ちる）。接地: 底からは欠かず、下のブロックに載っていない片は落ちる", "pieces": {"mode": "peel", "fraction": 0.5, "peelNoise": 0.8, "protectCore": false, "grounded": true, "seed": 3}},
      {"id": 7, "kind": "pieceFilter", "note": "選んだブロックを消す", "pieces": {"keep": false}},
      {"id": 8, "kind": "piecesToMesh"},
      {"id": 9, "kind": "toVolume", "note": "ブロックを 1 つのボリュームにまとめる", "toVolume": {"resolution": 128}},
      {"id": 10, "kind": "volumeCrack", "note": "同じ系統で、残ったブロックの継ぎ目を細く開ける（途中で止まる有限の割れ目）", "volumeCrack": {"width": 0.008, "depth": 0.06, "variation": 0.6, "noise": 0.1, "extent": 0.25, "coverage": 0.6, "stagger": 0.3, "seed": 4}},
      {"id": 11, "kind": "planeCuts", "note": "節理と同じ 3 方向の局所の欠けで、ブロックの角を割る", "planeCuts": {"count": 90, "scope": "local", "radius": 0.05, "depthMin": 0.2, "depthMax": 0.45, "distribution": "directional", "systems": 3, "rotation": [0, 0, -14], "spread": 15, "seed": 12}},
      {"id": 12, "kind": "volumeNoise", "note": "割れ肌の細かい凹凸", "volumeNoise": {"type": "facet", "amount": 0.006, "scale": 18, "octaves": 2}},
      {"id": 13, "kind": "volumeEdgeWear", "volumeEdgeWear": {"amount": 0.008, "radius": 0.006, "noise": 0.6}},
      {"id": 14, "kind": "volumeClip", "note": "根元を斜面に埋める", "volumeClip": {"mode": "ground", "embed": 0.12}},
      {"id": 15, "kind": "volumeToMesh", "volumeToMesh": {"method": "dualContouring"}},
      {"id": 16, "kind": "meshOutput"}
    ],
