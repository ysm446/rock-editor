{
  "format": "rock-editor.scene",
  "version": 1,
  "graph": {
    "nodes": [
      {"id": 1, "kind": "baseRock", "note": "節理で割られる前の岩体。最終形より大きめ（奥行きも）にして、外に見える面が全て割れ面になるまで侵食する", "baseRock": {"shape": "box", "size": [11, 10, 8]}},
      {"id": 2, "kind": "scatterPoints", "note": "ブロックの母点。数でブロックの大きさが決まる（体積 880 m³ に 360 点で 1 個あたり約 2.4 m³）", "pieces": {"count": 360, "seed": 3}},
      {"id": 5, "kind": "voronoiFracture", "note": "点の Voronoi で不規則な多面体のブロックに割る。座標系を主な節理の向き（76°）に回し、伸長で節理面の方向に細長く・節理面に垂直に薄くする", "pieces": {"rotation": [0, 0, 76], "stretch": [2.5, 1, 1.6]}},
      {"id": 6, "kind": "pieceSelect", "note": "外周からの侵食（凍結破砕でブロックが抜け落ちる）。接地: 底からは欠かず、下のブロックに載っていない片は落ちる", "pieces": {"mode": "peel", "fraction": 0.7, "peelNoise": 0.6, "protectCore": false, "grounded": true, "seed": 3}},
      {"id": 7, "kind": "pieceFilter", "note": "選んだブロックを消す", "pieces": {"keep": false}},
      {"id": 17, "kind": "pieceTransform", "note": "ブロックごとのずれ・傾き（ばらつき）。継ぎ目が段違いに開き、そろった石積みに見えなくなる", "pieces": {"individual": true, "jitterPosition": [0.06, 0.04, 0.06], "jitterRotation": 2.5, "jitterSeed": 4}},
      {"id": 8, "kind": "piecesToMesh"},
      {"id": 9, "kind": "toVolume", "note": "ブロックを 1 つのボリュームにまとめる（ずれた隙間は継ぎ目として残る）", "toVolume": {"resolution": 128}},
      {"id": 11, "kind": "planeCuts", "note": "局所の欠けでブロックの角を割る", "planeCuts": {"count": 70, "scope": "local", "radius": 0.05, "depthMin": 0.2, "depthMax": 0.45, "seed": 12}},
      {"id": 12, "kind": "volumeNoise", "note": "割れ肌の細かい凹凸", "volumeNoise": {"type": "facet", "amount": 0.006, "scale": 18, "octaves": 2}},
      {"id": 13, "kind": "volumeEdgeWear", "volumeEdgeWear": {"amount": 0.008, "radius": 0.006, "noise": 0.6}},
      {"id": 14, "kind": "volumeClip", "note": "根元を斜面に埋める", "volumeClip": {"mode": "ground", "embed": 0.16}},
      {"id": 15, "kind": "volumeToMesh", "volumeToMesh": {"method": "dualContouring"}},
      {"id": 16, "kind": "meshOutput"}
    ],
    "links": [
      {"from": "1", "to": "2"},
      {"from": "1", "to": "5:Geometry"},
