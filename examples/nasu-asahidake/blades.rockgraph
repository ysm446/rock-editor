        "note": "角の摩耗",
        "volumeEdgeWear": {
          "amount": 0.004,
          "radius": 0.006,
          "noise": 0.6
        }
      },
      {
        "id": 14,
        "kind": "volumeClip",
        "note": "裾を 10% 埋めて接地する",
        "volumeClip": {
          "mode": "ground",
          "embed": 0.1
        }
      },
      {
        "id": 15,
        "kind": "volumeToMesh",
        "volumeToMesh": {
          "method": "dualContouring"
        }
      },
      {
        "id": 16,
        "kind": "meshOutput"
      },
